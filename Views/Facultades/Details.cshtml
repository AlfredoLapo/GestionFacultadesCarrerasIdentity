@model GestionFacultadesCarrerasIdentity.Models.Facultad

@{
    ViewData["Title"] = "Detalles de Facultad";
}

<h1>Detalles de Facultad</h1>

<div>
    <h4>Información de la Facultad</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nombre)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nombre)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Decano)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Decano)
        </dd>
    </dl>
</div>

<div>
    @if (User.IsInRole("Coordinador"))
    {
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning">
            Editar
        </a>
    }

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver al listado
    </a>
</div>

@model IEnumerable<GestionFacultadesCarrerasIdentity.Models.Carrera>

@{
    ViewData["Title"] = "Carreras";
}

<h1>Listado de Carreras</h1>

@if (User.IsInRole("Coordinador"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">
            Crear nueva carrera
        </a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Codigo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DuracionSemestres)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Facultad)
            </th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Nombre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Codigo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.DuracionSemestres)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Facultad!.Nombre)
                </td>
                <td>
                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-info btn-sm">
                        Detalles
                    </a>

                    @if (User.IsInRole("Coordinador"))
                    {
                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                            Editar
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">
                            Eliminar
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
